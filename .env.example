# Supabase — the project's own, not a shared one (docs/08-deployment.md §2).
# The anon key is public by design: it ships in the client bundle and RLS is
# what protects the data. The service_role key never belongs in this file.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Absolute URL for magic links and the OAuth callback. Only needed in
# production; locally the app falls back to window.location.origin.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Settings → About → Send feedback. Unset, the row is not offered.
NEXT_PUBLIC_FEEDBACK_EMAIL=you@example.com

# Any long random string. Vercel sends it as a bearer token to the keep-alive
# cron; the route refuses to run without it (docs/08-deployment.md §4).
CRON_SECRET=
